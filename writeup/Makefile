SHELL := /bin/bash

OUT_DIR := out_submit
LATEXMK := latexmk -norc -xelatex -interaction=nonstopmode -shell-escape -outdir=$(OUT_DIR)
MAIN := main
SUBMISSION := main-submission
MAIN_WRAPPER := $(OUT_DIR)/$(MAIN)-make.tex
SUBMISSION_WRAPPER := $(OUT_DIR)/$(SUBMISSION)-make.tex
WORDCOUNT_SOURCES := 1_introduction.tex 2_background.tex 3_related_work.tex 4_implementation.tex 5_evaluation.tex 6_conclusions.tex
WORDCOUNT_TEX := $(OUT_DIR)/generated-wordcount.tex

.PHONY: all identified submission wordcount clean

all: identified submission

identified: $(WORDCOUNT_TEX) $(MAIN_WRAPPER)
	$(LATEXMK) -jobname=$(MAIN) $(MAIN_WRAPPER)

submission: $(SUBMISSION).tex $(WORDCOUNT_TEX) $(SUBMISSION_WRAPPER)
	$(LATEXMK) -jobname=$(SUBMISSION) $(SUBMISSION_WRAPPER)

$(SUBMISSION).tex: $(MAIN).tex
	sed -e 's/^%[[:space:]]*\(\\submissiontrue\)/\1/' $< > $@

$(MAIN_WRAPPER): $(MAIN).tex Makefile | $(OUT_DIR)
	printf '\\def\\fedctlbuildoutputdir{%s}\n\\input{%s.tex}\n' '$(OUT_DIR)' '$(MAIN)' > $@

$(SUBMISSION_WRAPPER): $(SUBMISSION).tex Makefile | $(OUT_DIR)
	printf '\\def\\fedctlbuildoutputdir{%s}\n\\input{%s.tex}\n' '$(OUT_DIR)' '$(SUBMISSION)' > $@

$(WORDCOUNT_TEX): $(WORDCOUNT_SOURCES) Makefile | $(OUT_DIR)
	count=$$(texcount -merge -sum -q $(WORDCOUNT_SOURCES) | awk '/^Total$$/{in_total=1} in_total && /^Sum count:/{print $$3; exit}'); \
	test -n "$$count"; \
	count_commas=$$(perl -e '$$n=shift; 1 while $$n =~ s/^(-?\d+)(\d{3})/$$1,$$2/; print $$n' "$$count"); \
	{ \
	  printf '%% Auto-generated by Makefile; do not edit.\n'; \
	  printf '\\newcommand{\\mainwordcount}{%s}\n' "$$count_commas"; \
	  printf '\\newcommand{\\mainwordcountplain}{%s}\n' "$$count"; \
	} > $@

$(OUT_DIR):
	mkdir -p $(OUT_DIR)

wordcount:
	@texcount -merge -sum -q $(WORDCOUNT_SOURCES) | awk '/^Total$$/{in_total=1} in_total && /^Sum count:/{print $$3; exit}'

clean:
	$(LATEXMK) -C $(MAIN).tex
	if [ -f $(SUBMISSION).tex ]; then $(LATEXMK) -C $(SUBMISSION).tex; fi
	if [ -f $(MAIN_WRAPPER) ]; then $(LATEXMK) -C -jobname=$(MAIN) $(MAIN_WRAPPER); fi
	if [ -f $(SUBMISSION_WRAPPER) ]; then $(LATEXMK) -C -jobname=$(SUBMISSION) $(SUBMISSION_WRAPPER); fi
	rm -f $(SUBMISSION).tex $(WORDCOUNT_TEX) $(MAIN_WRAPPER) $(SUBMISSION_WRAPPER)
